@model IEnumerable<CampusShare.Web.Models.Reserva>

@{
    ViewData["Title"] = "Reservas Pendientes";
}

<div class="reservas-pendientes-wrapper">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>
                <i class="bi bi-clock-history"></i>
                Reservas Pendientes de Aprobación
            </h2>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No hay reservas pendientes de aprobación.
            </div>
        }
        else
        {
            <div class="table-responsive reservas-table-card">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Artículo</th>
                            <th>Fecha Solicitud</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reserva in Model)
                        {
                            <tr>
                                <td><code>@reserva.Id</code></td>

                                <td>
                                    <div>
                                        <strong>@reserva.Alumno?.Nombre @reserva.Alumno?.Apellido</strong><br />
                                        <small class="text-muted">@reserva.Alumno?.Email</small>
                                    </div>
                                </td>

                                <td>
                                    <strong>@reserva.Articulo?.Nombre</strong>
                                </td>

                                <td>@reserva.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@reserva.FecInicio</td>
                                <td>@reserva.FecFin</td>

                                <td class="text-center">
                                    <div class="btn-group">

                                        <!-- Aprobar -->
                                        <form asp-action="Aprobar" asp-route-id="@reserva.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-check-circle"></i> Aprobar
                                            </button>
                                        </form>

                                        <!-- Abrir Modal Rechazar -->
                                        <button class="btn btn-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#rechazarModal@(reserva.Id)">
                                            <i class="bi bi-x-circle"></i> Rechazar
                                        </button>

                                        <!-- Cancelar -->
                                        <form asp-action="Cancelar" asp-route-id="@reserva.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-secondary btn-sm">
                                                <i class="bi bi-ban"></i> Cancelar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- 🔥🔥🔥 MODALS FUERA DE LA TABLA (CORRECTO) -->
@foreach (var reserva in Model)
{
    <div class="modal fade" id="rechazarModal@(reserva.Id)" tabindex="-1"
         aria-labelledby="rechazarModalLabel@(reserva.Id)" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <form asp-action="Rechazar" asp-route-id="@reserva.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="rechazarModalLabel@(reserva.Id)">
                            <i class="bi bi-x-circle"></i> Rechazar Reserva #@reserva.Id
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            Esta acción notificará al usuario que su reserva fue rechazada.
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <strong>Motivo del rechazo <span class="text-danger">*</span></strong>
                            </label>

                            <textarea class="form-control" name="motivo" required rows="4"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit" class="btn btn-danger">
                            Confirmar Rechazo
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
}

@section Scripts {
    
    <!-- Script correcto para cerrar modal al enviar -->
    <script>
        document.querySelectorAll('.modal form').forEach(form => {
            form.addEventListener('submit', () => {
                const modalEl = form.closest('.modal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
}
