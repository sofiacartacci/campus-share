@model CampusShare.Web.Models.User
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="profile-wrapper">
    <div class="profile-card">

        <!-- Header -->
        <div class="profile-header text-center mb-4">
            <i class="bi bi-person-circle profile-icon"></i>
            <h2 class="profile-title">Mi Perfil</h2>
            <p class="profile-subtitle">Información personal de tu cuenta</p>
        </div>

        <!-- Datos -->
        <div class="row g-4">
            <div class="col-md-6">
                <div class="profile-item">
                    <i class="bi bi-person-fill profile-item-icon"></i>
                    <div>
                        <label>Nombre</label>
                        <p>@Model.Nombre</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="profile-item">
                    <i class="bi bi-person-fill profile-item-icon"></i>
                    <div>
                        <label>Apellido</label>
                        <p>@Model.Apellido</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="profile-item">
                    <i class="bi bi-badge-id profile-item-icon"></i>
                    <div>
                        <label>DNI</label>
                        <p>@Model.Dni</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="profile-item">
                    <i class="bi bi-envelope-fill profile-item-icon"></i>
                    <div>
                        <label>Email</label>
                        <p>@Model.Email</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="profile-item">
                    <i class="bi bi-person-badge-fill profile-item-icon"></i>
                    <div>
                        <label>Rol</label>
                        <p>@Model.Role</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
